{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\".agents/skills/phoenix-ui/scripts/phoenix-ui\" hook",
            "commandWindows": "cmd /d /c \".agents\\skills\\phoenix-ui\\scripts\\phoenix-ui.cmd\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\".agents/skills/phoenix-ui/scripts/phoenix-ui\" hook",
            "commandWindows": "cmd /d /c \".agents\\skills\\phoenix-ui\\scripts\\phoenix-ui.cmd\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
