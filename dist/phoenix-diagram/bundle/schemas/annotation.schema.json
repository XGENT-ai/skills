{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XGENT-ai/skills/schemas/phoenix-diagram/annotation.schema.json",
  "title": "Phoenix Diagram Word-by-word Annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "sentences"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "annotation"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "$ref": "common.schema.json#/$defs/locale"
        },
        "translations": {
          "$ref": "common.schema.json#/$defs/translations"
        },
        "subtitle": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "animation": {
          "$ref": "common.schema.json#/$defs/animation"
        },
        "visual_preset": {
          "$ref": "common.schema.json#/$defs/visualPreset"
        },
        "quality_profile": {
          "$ref": "common.schema.json#/$defs/qualityProfile"
        }
      }
    },
    "sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "annotations"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "aside": {
            "type": "string",
            "minLength": 1
          },
          "footnote": {
            "type": "string",
            "minLength": 1
          },
          "annotations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "span"
              ],
              "anyOf": [
                {
                  "required": [
                    "note"
                  ]
                },
                {
                  "required": [
                    "fix"
                  ]
                }
              ],
              "properties": {
                "span": {
                  "type": "string",
                  "minLength": 1
                },
                "occurrence": {
                  "type": "integer",
                  "minimum": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                },
                "issue": {
                  "type": "boolean"
                },
                "fix": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "if": {
                "required": [
                  "fix"
                ]
              },
              "then": {
                "required": [
                  "issue"
                ],
                "properties": {
                  "issue": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "cards": {
      "$ref": "common.schema.json#/$defs/cards"
    }
  }
}
