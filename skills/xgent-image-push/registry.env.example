# 私有镜像仓库 —— 本地配置模板
#
#   cp registry.env.example ./.xgent-registry.env     # 或放 ~/.config/xgent/registry.env
#   chmod 600 ./.xgent-registry.env                   # 若里面写了 ROBOT_SECRET
#
# ⚠️ 填好的那一份**不要提交进 git**（仓库地址属内部信息）。
#    放在项目里就加进 .gitignore：echo '.xgent-registry.env' >> .gitignore
#
# 按 KEY=value 解析，不会被 shell 执行；未列出的键一律忽略。
# 同名**环境变量优先**——CI 里直接注入即可，不必落盘。

# ── 必填 ────────────────────────────────────────────────
# 仓库域名。不带协议、小写、无尾斜杠。地址问运维要。
REGISTRY=
# Harbor 项目名。镜像完整引用 = ${REGISTRY}/${PROJECT}/<app>:<tag>
PROJECT=

# ── 推送身份（本地开发填这里；CI 请用 secret 注入，别落盘）──
# 形如 robot$<project>+<app>。注意在 shell 里要用单引号，$ 会被展开。
#ROBOT_USER=
#ROBOT_SECRET=

# ── 可选，有默认值 ──────────────────────────────────────
# 构建平台。生产机是 x86_64，改之前先确认。
#PLATFORM=linux/amd64
# 保留策略保留最近 K 个 tag，仅用于预警文案，要与服务端实际配置一致。
#RETAIN_K=10
# 链路预检的 TLS 握手阈值（毫秒）。超过即判定为跨境链路并拒绝推送。
#CONNECT_WARN_MS=300
