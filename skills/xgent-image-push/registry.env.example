# 私有镜像仓库 —— 本地配置模板
#
#   cp registry.env.example ./.xgent-registry.env     # 或放 ~/.config/xgent/registry.env
#   chmod 600 ./.xgent-registry.env                   # 若里面写了 ROBOT_SECRET
#
# ⚠️ 填好的那一份**不要提交进 git**（仓库地址属内部信息）。
#    放在项目里就加进 .gitignore：echo '.xgent-registry.env' >> .gitignore
#
# 按 KEY=value 解析，不会被 shell 执行；未列出的键一律忽略。
# 同名**环境变量优先**——CI 里直接注入即可，不必落盘。

# ── 必填 ────────────────────────────────────────────────
# 仓库域名。不带协议、小写、无尾斜杠。地址问运维要。
REGISTRY=
# Harbor 项目名。镜像完整引用 = ${REGISTRY}/${PROJECT}/<app>:<tag>
PROJECT=

# ── 推送身份（本地开发填这里；CI 请用 secret 注入，别落盘）──
# 形如 robot$<project>+<app>。注意在 shell 里要用单引号，$ 会被展开。
#ROBOT_USER=
#ROBOT_SECRET=

# ── 可选，有默认值 ──────────────────────────────────────
# tag 格式的正则。**不配只提醒，配了就强制。**
# 团队统一格式之后建议配上——否则迟早出现 v1.2.3 / 1.2.3 / build-42 混用。
# 下面这条对应推荐规范 v<MAJOR>.<MINOR>.<PATCH>-<7位 git sha>，sha 部分可省略：
#TAG_PATTERN=^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9a-f]{7,40})?$
# 允许当**可变指针**用的 tag 名（空格或逗号分隔）。默认空 = 一个都不许，
# 推 latest / prod / main 这类名字会被硬拒。
#
# ⚠️ 只有**不经部署侧**的项目才该打开它 —— 也就是给人手工 docker pull 的镜像
#    （本地调试环境那一类）。**部署侧按镜像引用触发重建的项目不要开**：那边的整条推理是
#    「新 tag ⇒ 引用变化 ⇒ 触发重建 ⇒ 有回滚目标」，可变 tag 一进来就断了，
#    表现是"发版了但线上还跑着旧的"，且没有可回退的目标。
#
# 逐个列名，不是一个总开关：写 MUTABLE_TAGS=latest 之后 prod / main / stable
# 这些打错的名字仍然被拦着。
#
# 打开之后，这些 tag **只能移动、不能推**：
#   push-image.sh <app> v1.2.3-1a2b3c4                    # ① 先推不可变的那一份
#   push-image.sh <app> latest --point-at v1.2.3-1a2b3c4  # ② 再把指针移过去（原样重打 tag，不传字节）
# 直接 build 成 latest 推上去会被脚本拦下 —— 理由是 GC：latest 一移走，
# 上一个 digest 若没有别的 tag 就成了 untagged，下一次 GC 连底层 blob 一起回收，
# 这个 repo 就永远只剩一份镜像，既没有历史也没有可回退的目标。
#MUTABLE_TAGS=latest
# 构建平台。生产机是 x86_64，改之前先确认。
#PLATFORM=linux/amd64
# 保留策略保留最近 K 个 tag，仅用于预警文案，要与服务端实际配置一致。
#RETAIN_K=10
# 链路预检的 TLS 握手阈值（毫秒）。超过即判定为跨境链路并拒绝推送。
#CONNECT_WARN_MS=300
