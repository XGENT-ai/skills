    "confirmationMargin": "0.5",
    "plateauWindow": 3,
    "minimumBestGrowth": "1.0",
    "maxRefactorsPerScope": 1
  },
  "verdictOrder": [
    "需补证",
    "通过验收",
    "需用户裁定",
    "需要修改"
  ],
  "applicability": {
    "globalScore": [
      "full round",
      "complete evidence",
      "all units judged",
      "minimum unit score"
    ],
    "confirmation": [
      "preliminary full pass",
      "no P0/P1 gating gaps",
      "minimum unit score < threshold + 0.5",
      "same materials; fresh reviewer; per-unit whole-review minimum; gap union"
    ],
    "globalPlateau": [
      "current score below threshold",
      "at least three valid complete full rounds in same target baseline",
      "historical best grows less than 1.0 from two valid rounds earlier"
    ],
    "stubbornGap": [
      "P0-P2 only",
      "attempted before a present/regressed assessment, or two consecutive partial assessments each preceded by an attempt",
      "unknown legacy attempt history is not zero"
    ],
    "stagnation": [
      "warning remains warning without recorded refactor",
      "recorded refactor plus warning becomes stagnation",
      "unknown legacy refactor count is not zero"
    ],
    "reviewerStatusMerge": [
      "one old gap judged by several reviewers of the same packet keeps the earliest status in reviewerStatusPrecedence",
      "an open or unverified status from any reviewer beats a closing one (gap union)"
    ],
    "priorDisposition": [
      "only repair records since the gap's last independent judgement",
      "a later record in the same round replaces that round's earlier disposition for the gap",
      "attempted: some round's final disposition is 已修改待评审",
      "latest: the most recent round's final disposition; 不采纳 with a reassessed open gap, or 待决定/阻塞, is pending",
      "attempted and latest are evaluated independently"
    ]
  },
  "waiver": {
    "verdict": "用户豁免通过",
    "appendOnly": true,
    "preserveScoreAndGaps": true
  },
  "dispositions": [
    "已修改待评审",
    "不采纳",
    "待决定",
    "阻塞",
    "未处理"
