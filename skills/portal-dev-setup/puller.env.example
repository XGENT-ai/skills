# 门户一盒 —— 镜像拉取凭证（本地配置模板）
#
#   cp puller.env.example ./.xgent-registry.env    # 或放 ~/.config/xgent/registry.env
#   chmod 600 ./.xgent-registry.env
#   echo '.xgent-registry.env' >> .gitignore       # ⚠️ 别提交
#
# 按 KEY=value 逐行填。同名【环境变量优先】—— CI 里直接注入 REGISTRY / PULLER_AUTH，
# 不必落盘。查找顺序见 onebox.sh --help。

# ── 必填 ────────────────────────────────────────────────
# 镜像仓库域名。不带 https://、不带端口、无尾斜杠。地址找你们的开发团队要。
REGISTRY=

# 只读拉取凭证 = base64 的「用户名:口令」。
#
#   printf '%s' '<用户名>:<口令>' | base64
#
# 它和 ~/.docker/config.json 里 auths.<REGISTRY>.auth 是同一个值，两边可以互抄。
# 这是【团队共用的只读凭证】，不是谁的个人密码：有人离职要找开发团队轮换，
# 而轮换会同时作废全团队的现有凭证。
#
# ⚠️ base64 不是加密 —— `base64 -d` 一条命令就还原成明文。别提交进 git，
#    别转发出团队；共用机器上让它进系统钥匙串（Docker 的 credsStore）。
PULLER_AUTH=

# 【门户一盒镜像】所在的项目名。填了它 `onebox.sh init` / `pull` 就不用 --image ——
# 默认拉 <REGISTRY>/<ONEBOX_PROJECT>/one-box:latest（反代同仓同 tag）。值找开发团队要。
ONEBOX_PROJECT=

# 【你自己 App 镜像】要推到哪个项目（xgent-image-push 用的就是这一项，两个 skill 共用本文件）。
# ⚠️ 它和 ONEBOX_PROJECT 通常【不是同一个】：一盒是门户团队发的调试镜像，你的 App 镜像在你自己的项目下。
# 只起一盒、不推镜像的话可以留空；ONEBOX_PROJECT 缺席时脚本会回退用它并明确告警。
PROJECT=

# ── App 清单目录（可选，APP-CATALOG-1）────────────────────
# 一盒的 `add <key>` 默认从【清单目录】拉那个 App 的清单，取代「镜像里只预置了那几份
# 样例」。目录是一份**只读投影**：它只回一份 JSON，不下发、不部署、不编排任何东西。
#
# 地址与令牌找开发团队要。两项都留空 ⇒ `add` 回落到镜像自带的样例清单（离线可用）。

# 目录部署的地址（带协议，无尾斜杠）。同时是 release-cli 投递清单的第二站。
MANIFEST_STORE=

# 目录【只读】令牌（xcat_…）。它是跨 App 的读凭证 —— 一把泄露 = 全部 App 的公开清单
# 可读（公开字段而已，里面没有任何密钥），但仍要按凭证对待：chmod 600 + 别提交。
MANIFEST_STORE_READ_TOKEN=

# ── 发布（xgent-app-release 用的三项，两个 skill 共用本文件）────────────
# 本文件就是【凭证文件】：令牌写这里，release-cli 自己读，于是令牌**从不经过 agent
# 的上下文**。反过来强制走 --token，agent 必须先把它取出来再传进去 —— 那才是把密钥
# 写进对话记录、工具日志和命令行（同机 `ps` 可见）。
# release-cli 每次运行都替你查两条：文件 mode 是不是 600、有没有被 .gitignore 挡住。

# 本次发版的【目标部署】地址（等价于旧的 XGENT_PORTAL_URL，两者都认）。
TARGET_XGENT_PLATFORM=

# 目标部署的发布令牌（xrel_…，按 App 绑定）。平台管理员在 控制台 › 应用市场 签发。
XGENT_RELEASE_TOKEN=

# 目录部署的发布令牌（xrel_…）。未填 ⇒ 回落 XGENT_RELEASE_TOKEN
# （TARGET_XGENT_PLATFORM 与 MANIFEST_STORE 是同一台时，那就是对的那把）。
MANIFEST_STORE_TOKEN=

# 这个仓库对应的应用标识。一个 repo 一个 App，从头到尾不变。
LISTING_KEY=
