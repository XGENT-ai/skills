{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XGENT-ai/skills/schemas/phoenix-diagram/statechart.schema.json",
  "title": "Phoenix Diagram Statechart",
  "description": "A finite state model the engine explores exhaustively. Rules are checked in every reachable state, the shortest path to each broken rule is reported, and a view projects the model states onto a flat, parent-state or parallel-region chart.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "model"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "statechart"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "output"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "output": {
          "$ref": "common.schema.json#/$defs/portableOutputPath"
        },
        "locale": {
          "$ref": "common.schema.json#/$defs/locale"
        },
        "translations": {
          "$ref": "common.schema.json#/$defs/translations"
        },
        "visual_preset": {
          "$ref": "common.schema.json#/$defs/visualPreset"
        },
        "quality_profile": {
          "$ref": "common.schema.json#/$defs/qualityProfile"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variables",
        "init",
        "actions"
      ],
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "description": "Exactly one of values (strings, booleans or integers, all of one kind) or range [lo, hi] (integers).",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "values": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "boolean"
                    }
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer"
                    }
                  }
                ]
              },
              "range": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "oneOf": [
              {
                "required": [
                  "values"
                ],
                "not": {
                  "required": [
                    "range"
                  ]
                }
              },
              {
                "required": [
                  "range"
                ],
                "not": {
                  "required": [
                    "values"
                  ]
                }
              }
            ]
          }
        },
        "init": {
          "type": "object",
          "description": "Every variable id mapped to its initial value, or to a non-empty array of alternative initial values.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": [
                  "string",
                  "integer",
                  "boolean"
                ]
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "integer",
                    "boolean"
                  ]
                }
              }
            ]
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "pick": {
                "type": "object",
                "description": "Parameter name to the finite values the action may take.",
                "propertyNames": {
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "boolean"
                      }
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "integer"
                      }
                    }
                  ]
                }
              },
              "when": {
                "$ref": "#/$defs/expr"
              },
              "set": {
                "type": "object",
                "description": "Variable id to its value after the step, computed from the values before it.",
                "additionalProperties": {
                  "$ref": "#/$defs/expr"
                }
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "holds"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "One sentence a reader agrees the system must keep true."
              },
              "holds": {
                "$ref": "#/$defs/expr"
              }
            }
          }
        },
        "deadlock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "check": {
              "type": "boolean"
            },
            "ends": {
              "$ref": "#/$defs/expr"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "not": {
        "required": [
          "state",
          "regions"
        ]
      },
      "properties": {
        "state": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "when": {
                "$ref": "#/$defs/expr"
              },
              "label": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                ]
              }
            }
          }
        },
        "regions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "state"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "when": {
                      "$ref": "#/$defs/expr"
                    },
                    "label": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "label"
            ],
            "properties": {
              "action": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "when": {
                "$ref": "#/$defs/expr"
              },
              "label": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group"
            ],
            "properties": {
              "when": {
                "$ref": "#/$defs/expr"
              },
              "group": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "colors": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "cyan",
              "emerald",
              "violet",
              "amber",
              "orange",
              "slate"
            ]
          }
        }
      }
    },
    "cards": {
      "$ref": "common.schema.json#/$defs/cards"
    }
  },
  "$defs": {
    "expr": {
      "description": "A literal, or an object with exactly one operator key.",
      "anyOf": [
        {
          "type": [
            "string",
            "integer",
            "boolean"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "var"
          ],
          "properties": {
            "var": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "next"
          ],
          "properties": {
            "next": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "param"
          ],
          "properties": {
            "param": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/expr"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "and"
          ],
          "properties": {
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "or"
          ],
          "properties": {
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implies"
          ],
          "properties": {
            "implies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eq"
          ],
          "properties": {
            "eq": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ne"
          ],
          "properties": {
            "ne": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lt"
          ],
          "properties": {
            "lt": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "le"
          ],
          "properties": {
            "le": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gt"
          ],
          "properties": {
            "gt": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ge"
          ],
          "properties": {
            "ge": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "in"
          ],
          "properties": {
            "in": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/expr"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": [
                      "string",
                      "integer",
                      "boolean"
                    ]
                  }
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "add"
          ],
          "properties": {
            "add": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sub"
          ],
          "properties": {
            "sub": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "if"
          ],
          "properties": {
            "if": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      ]
    }
  }
}
