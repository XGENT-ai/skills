{
  "name": "@xgent-ai/skills",
  "version": "0.6.0",
  "description": "XGENT skills 与 Claude Code 辅助工具:通过 npx 为项目安装 hooks、启用 settings,并安装 vendor 的 impeccable",
  "keywords": [
    "claude-code",
    "skills",
    "statusline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XGENT-ai/skills.git"
  },
  "license": "MIT",
  "bin": {
    "xgent-skills": "bin/xgent-skills.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js test/*/*.test.js && for d in test/codex test/dev-plan test/skills skills/agi-mode/evals; do python3 -m unittest discover -s \"$d\" -p 'test_*.py' || exit 1; done"
  },
  "files": [
    "bin",
    ".claude/hooks",
    "hooks/codex/context-goal-guard.py",
    "hooks/codex/hooks.example.json",
    "docs/codex-context-goal-guard.md",
    "hooks/claude/context-goal-guard.js",
    "hooks/claude/settings.example.json",
    "docs/claude-context-goal-guard.md",
    "skills",
    "vendor/impeccable/bundle",
    "vendor/impeccable/VERSION.json",
    "vendor/impeccable/LICENSE",
    "vendor/impeccable/NOTICE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
