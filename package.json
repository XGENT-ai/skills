{
  "name": "@xgent-ai/skills",
  "version": "0.7.2",
  "description": "XGENT skills 与 Claude Code 辅助工具:通过 npx 为项目安装 hooks、启用 settings,并安装 Phoenix UI 设计工具与 UI 验收 skills",
  "keywords": [
    "claude-code",
    "skills",
    "statusline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XGENT-ai/skills.git"
  },
  "license": "MIT",
  "bin": {
    "xgent-skills": "bin/xgent-skills.js",
    "phoenix-ui": "bin/phoenix-ui.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:phoenix": "node scripts/test-phoenix-ui.mjs",
    "release:phoenix": "node scripts/release-phoenix-ui.mjs",
    "prepublishOnly": "node scripts/require-release-package.mjs"
  },
  "files": [
    "bin",
    ".claude/hooks",
    "hooks/codex/context-goal-guard.py",
    "hooks/codex/hooks.example.json",
    "docs/codex-context-goal-guard.md",
    "hooks/claude/context-goal-guard.js",
    "hooks/claude/settings.example.json",
    "docs/claude-context-goal-guard.md",
    "docs/phoenix-ui.md",
    "skills",
    "dist/phoenix-ui/bundle",
    "dist/phoenix-ui/VERSION.json",
    "dist/phoenix-ui/LICENSE",
    "dist/phoenix-ui/NOTICE.md",
    "dist/phoenix-ui/THIRD-PARTY.json",
    "dist/phoenix-ui/THIRD-PARTY-NOTICES.md",
    "dist/phoenix-ui/THIRD-PARTY-LICENSES"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
