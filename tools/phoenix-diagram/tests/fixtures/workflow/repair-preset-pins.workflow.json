  "cards": [
    {
      "dot": "amber",
      "title": "负责人直接批准的条件",
      "items": [
        "风险方案已确认，且涉及文件不超过10个；两个条件必须同时满足。",
        "其余情况先交安全审查员复核，负责人进入审批不等于已经批准。"
      ]
    },
    {
      "dot": "violet",
      "title": "安全复核的往返",
      "items": [
        "复核拒绝 → 负责人重新确认 → 再次交安全审查员复核。",
        "重新确认后仍须复核通过，才能由维护者合并。"
      ]
    },
    {
      "dot": "cyan",
      "title": "撤回与执行职责",
      "items": [
        "提交、补充材料、材料检查、负责人审批、负责人批准、安全复核和重新确认阶段，均可由提交者撤回。",
        "各阶段旁的“已撤回”表示同一种终止结果；每条撤回线都可直接结束本次申请。",
        "图中两条合并路径均汇入“维护者执行合并”；合并后流程结束。",
        "本图为虚构的验收流程，不代表实际组织制度。"
      ]
    }
