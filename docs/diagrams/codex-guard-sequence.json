    {
      "dot": "cyan",
      "title": "只读，不代劳",
      "items": [
        "hook 只读取会话记录和 goal 库，不写进度、不改 goal、不开新对话",
        "占比来自最新一条完整 token_count，可能滞后于界面上的百分比",
        "累计、缓存、reasoning tokens 不重复计入；压缩或换模型后没有新统计就不沿用旧值"
      ]
    },
    {
      "dot": "emerald",
      "title": "暂停必须由人先授权",
      "items": [
        "安装、信任、读完说明都不构成暂停授权",
        "用户要在当前 goal 的指令里明确 65% 暂停策略，agent 才调用原生工具",
        "/goal resume 撤销先前授权，恢复后需重新明确"
      ]
    },
    {
      "dot": "amber",
      "title": "提醒不等于暂停",
      "items": [
        "提醒依赖 agent 执行，hook 不能强制暂停",
        "只有 get_goal 复核为 paused 才算暂停成功",
        "写记录失败时，回复里保留最小交接摘要并说明失败"
      ]
    }
  ]
