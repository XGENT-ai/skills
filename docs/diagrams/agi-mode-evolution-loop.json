  "cards": [
    {
      "dot": "emerald",
      "title": "达到什么才算一轮有效",
      "items": [
        "先用初始对象测出基线，再比较候选",
        "收益要超过测量噪声，并有实际价值",
        "同时检查质量底线与相邻场景有没有回归",
        "记录这轮花了多少实验、验证与运行成本"
      ]
    },
    {
      "dot": "cyan",
      "title": "重放的三个证据层级",
      "items": [
        "历史效果复核：重读原始产物，只说明当时发生了什么",
        "代理验证：给候选当时的输入，只支持局部机制假设",
        "实际效果验证：让候选参与新的可比执行，才谈真实效果",
        "历史材料不能直接给新候选打效果分"
      ]
    },
    {
      "dot": "amber",
      "title": "两类记录缺一不可",
      "items": [
        "工作样本：真实任务的输入、条件、产物与效果",
        "进化尝试：假设、父版本、候选差异、验证与去留理由",
        "只有工作样本，得到的是案例库",
        "两类关联起来，才能评价经验有没有被用好"
      ]
    },
    {
      "dot": "rose",
      "title": "容易走偏的地方",
      "items": [
        "规则数量、修改次数、自我评价都不能当能力证明",
        "不能同时改对象和评分口径，再把分数变化算成改进",
        "确认集一旦用于选择，就不再是未见数据",
        "确认失败就恢复仍有效的已确认版本，不要反复试到出赢家"
      ]
    }
  ]
